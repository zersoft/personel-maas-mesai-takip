# Kopyalayın: .env.example dosyasını .env olarak kopyalayıp değerleri doldurun.
# cp .env.example .env

# Ana veritabanı (personel takip)
DB_HOST=mysqldb
DB_NAME=zersoftn_personel_takip
DB_USER=zersoftn_personel_takip
DB_PASS=

# Raporlama veritabanı (koka_hy) – isteğe bağlı
DB_REPORT_HOST=mysqldb
DB_REPORT_NAME=zersoftn_koka_hy
DB_REPORT_USER=zersoftn_koka
DB_REPORT_PASS=
